<Routines>
<Routine Name="CheckConnections" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Use the heartbeat check AOI to check if the camera program is online. This should run at all times that the PC is on and the camera app is alive. 

Each individual camera process can have its own connection heartbeat, but these can be enabled/disable individually if you only need one heartbeat check.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Note: camera program uses an explicit (class 3) connection and write directly to the heartbeat tag]]>
</Comment>
<Text>
<![CDATA[HeartbeatCheck(cameraConnection);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(CheckConnections,0);]]>
</Text>
</Rung>
</RLLContent>
