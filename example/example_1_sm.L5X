<AddOnInstructionDefinition Name="HeartbeatCheck" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-03-16T23:18:11.855Z" CreatedBy="ROCKWELL-VM\Zac" EditedDate="2026-03-17T21:24:59.240Z" EditedBy="ROCKWELL-VM\Zac" SoftwareRevision="v37.00">
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="heartbeat" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[toggled every 1s by PC if connected]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="connected" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[indicates the heartbeat is alive]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="heartbeatInterval" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[ms before heartbeat is missed. Should be slightly greater than time in PC prg to accound for jitter]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[1250]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="1250"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="ons" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="heartbeatCheckTimer" DataType="TIMER" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,1500,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="1500"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[HeartbeatCheck:

Monitors the status of a heartbeat signals and returns a "connected" signal if it is updating as expected

To use, place on a rung and run all the time
Set the `heartbeat` tag on and off at the `heartbeatInterval`
the `connected` output will stay on as long as the heartbeat continues to toggle on and off]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[GE(heartbeatInterval,0)MOVE(heartbeatInterval,heartbeatCheckTimer.PRE);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Reset a running a timer anytime the heartbeat changes. If the timer ever finishes, the camera program is disconnected. Heartbeat should toggle approx every 1s]]>
</Comment>
<Text>
<![CDATA[[XIC(heartbeat) ONS(ons.0) ,XIO(heartbeat) ONS(ons.1) ]RES(heartbeatCheckTimer);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[TON(heartbeatCheckTimer,?,?) ,XIC(heartbeatCheckTimer.TT) OTE(connected) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="SeqCtrl" Revision="3.3" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2017-04-12T15:18:43.317Z" CreatedBy="A-I-CORP\ZWood" EditedDate="2024-09-04T21:38:06.473Z" EditedBy="A-I-CORP\ZWood" SoftwareRevision="v35.01">
<RevisionNote>
<![CDATA[v3.3 Fixed bug where state bits and step where out of sync for 1 scan
v3.2 fixed bug where first scan would not init to aborted
v3.1 add state back in and inActiveState outputs and fixed abortVisible bug
v3.0 Major overhaul of states, cmds, UDTs, etc. See AIC Wiki for details.
...]]>
</RevisionNote>
